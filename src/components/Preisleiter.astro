---
// Preisliste vom Self-Check bis zur Betreuung (Startseite und Leistungsübersicht).
interface Props { surface?: boolean; nummer?: string }
const { surface = false, nummer } = Astro.props;
const steps = [
  { t: 'Self-Check', d: 'HubSpot-Reifegrad in wenigen Minuten', p: 'kostenlos', href: 'https://docu.cognicore.de/self-check?lang=de' },
  { t: 'Gruppen-Onboarding', d: '90 Minuten live über Teams, je Unternehmen', p: '290 €', href: '/leistungen/hubspot-gruppen-onboarding#termine' },
  { t: 'Integrations-Check', d: 'HubSpot und Microsoft 365 an einem Beratertag', p: '1.250 €', href: '/leistungen/integrations-check' },
  { t: 'HubSpot-Audit', d: 'Bestehendes Portal mit Maßnahmenplan', p: 'ab 1.900 €', href: '/leistungen/hubspot-audit' },
  { t: 'HubSpot-Einführung', d: 'Mit Datenübernahme ab 9.500 €', p: 'ab 4.900 €', href: '/leistungen/hubspot-einfuehrung' },
  { t: 'Betreuung', d: 'HubSpot Managed Service, 5 Stunden im Monat', p: 'ab 850 € / Monat', href: '/leistungen/hubspot-managed-service' },
];
---
<section class={surface ? 'cc-section--surface' : ''} id="einstieg">
  <div class="cc-wrap cc-a-sec" style="padding-bottom:72px">
    <p class="cc-a-sec__label">{nummer ? `${nummer} ` : ''}Preise</p>
    <div class="cc-a-sec__body">
      <h2>Was es kostet.</h2>
      <p class="cc-a-sec__intro">Jeder Schritt hat einen festen Preis oder eine feste Untergrenze. Nach jedem Schritt entscheiden Sie, ob es weitergeht.</p>
      <div class="cc-a-prices">
        {steps.map((s) => (
          <a class="cc-a-price" href={s.href}>
            <span class="cc-a-price__name">{s.t}</span>
            <span class="cc-a-price__text">{s.d}</span>
            <span class="cc-a-price__value">{s.p}</span>
          </a>
        ))}
      </div>
      <p class="cc-a-note">Alle Preise netto zzgl. USt. Die HubSpot-Lizenzen zahlen Sie direkt an HubSpot.</p>
    </div>
  </div>
</section>
