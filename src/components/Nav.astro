---
interface Props { active?: string }
const { active } = Astro.props;
const links = [
  { href: '/leistungen', label: 'Leistungen', key: 'leistungen' },
  { href: '/ueber-uns', label: 'Über uns', key: 'ueber-uns' },
  { href: '/kontakt', label: 'Kontakt', key: 'kontakt' },
];
---
<header class="cc-nav" id="site-header">
  <a class="cc-nav__logo" href="/" aria-label="CogniCore IT Solutions — Startseite">
    <img src="/brand/cognicore-logo-blue-orange.png" alt="CogniCore IT Solutions" width="150" height="34" />
  </a>
  <nav class="cc-nav__links" aria-label="Hauptnavigation">
    {links.map((l) => (
      <a href={l.href} class={`cc-nav__link${active === l.key ? ' is-active' : ''}`}>{l.label}</a>
    ))}
  </nav>
  <div class="cc-nav__cta">
    <a class="cc-btn cc-btn--ghost" href="/kontakt">Kontakt</a>
    <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
  </div>
  <button class="cc-nav__burger" id="cc-burger" aria-label="Menü öffnen" aria-controls="cc-mobile" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
  <div class="cc-mobile" id="cc-mobile">
    {links.map((l) => (<a href={l.href}>{l.label}</a>))}
    <a class="cc-btn cc-btn--accent cc-btn--block" href="/kontakt#termin">Erstgespräch vereinbaren</a>
  </div>
</header>
