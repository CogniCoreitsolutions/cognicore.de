---
interface Props { active?: string }
const { active } = Astro.props;
const links = [
  { href: '/', label: 'Startseite', key: 'start' },
  { href: '/leistungen', label: 'Leistungen', key: 'leistungen', dd: [
    { href: '/leistungen#onboarding', label: 'HubSpot Onboarding' },
    { href: '/leistungen#support', label: 'Begleitung & Optimierung' },
    { href: '/leistungen#integration', label: 'Prozessintegration & APIs' },
  ] },
  { href: '/ueber-uns', label: 'Über uns', key: 'ueber-uns' },
  { href: '/kontakt', label: 'Kontakt', key: 'kontakt' },
];
---
<header class="site-header" id="site-header">
  <div class="wrap">
    <a href="/" aria-label="CogniCore IT Solutions — Startseite">
      <img class="logo" src="/img/logo.png" alt="CogniCore IT Solutions" width="184" height="52" />
    </a>
    <nav class="nav" id="nav" aria-label="Hauptnavigation">
      <div class="nav-links">
        {links.map((l) => l.dd ? (
          <div class="has-dd">
            <a href={l.href} class={active === l.key ? 'current' : ''}>
              {l.label}
              <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </a>
            <div class="dd">{l.dd.map((d) => (<a href={d.href}>{d.label}</a>))}</div>
          </div>
        ) : (
          <a href={l.href} class={active === l.key ? 'current' : ''}>{l.label}</a>
        ))}
      </div>
      <a href="/kontakt" class="btn btn-primary nav-cta">Let's talk!</a>
    </nav>
    <button class="hamburger" id="ham" aria-label="Menü öffnen">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>
