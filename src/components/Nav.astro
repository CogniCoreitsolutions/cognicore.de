---
import BrandMark from './BrandMark.astro';

interface Props { active?: string }
const { active } = Astro.props;

const links = [
  { href: '/leistungen', label: 'Leistungen', key: 'leistungen' },
  { href: '/ueber-uns', label: 'Über uns', key: 'ueber-uns' },
  { href: '/kontakt', label: 'Kontakt', key: 'kontakt' },
];
---
<nav class="nav" id="nav">
  <div class="wrap">
    <a href="/" class="brand" aria-label="CogniCore IT Solutions — Startseite">
      <BrandMark />
      <span>CogniCore</span>
    </a>
    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? 'current' : ''}>{l.label}</a>
      ))}
      <a href="/kontakt" class="m-cta">Erstgespräch vereinbaren</a>
    </div>
    <div class="nav-right">
      <button class="icon-btn" id="theme" aria-label="Farbschema umschalten">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="/kontakt" class="btn primary">Erstgespräch vereinbaren</a>
      <button class="icon-btn hamburger" id="ham" aria-label="Menü öffnen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</nav>
