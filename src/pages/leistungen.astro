---
import Base from '../layouts/Base.astro';

const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

const pillars = [
  {
    id: 'hubspot', img: '/img/feat-onboarding.jpg', rev: false,
    ey: '// HubSpot Onboarding',
    title: 'Sauber aufgesetzt statt zusammengeklickt.',
    copy: 'Ein Onboarding ist kein Klick-Setup, sondern der Startpunkt für ein tragfähiges CRM. Wir begleiten von der Zieldefinition über Workshops bis zum produktiven Go-Live — modular und skalierbar.',
    bullets: ['Zielbild, Datenmodell, Mappings & Datenstrukturen', 'Migration aus Salesforce, Pipedrive oder Excel', 'Team-Enablement und strukturierter Go-Live'],
  },
  {
    id: 'optimierung', img: '/img/feat-support.jpg', rev: true,
    ey: '// Begleitung & Optimierung',
    title: 'Nach dem Go-Live fängt der Wert erst an.',
    copy: 'Wir betreiben HubSpot nicht nur, wir entwickeln es aktiv weiter — proaktiv und mitdenkend, mit festen Ansprechpartnern statt anonymer Ticket-Warteschleife.',
    bullets: ['Automatisierungen, Workflows & Playbooks', 'Belastbares Reporting & Dashboards', 'Regelmäßige Reviews und strategisches Sparring'],
  },
  {
    id: 'integration', img: '/img/feat-integration.jpg', rev: false,
    ey: '// Prozess- & API-Integration',
    title: 'HubSpot als Schaltzentrale — technisch belastbar.',
    copy: 'Der volle Nutzen entsteht erst im Zusammenspiel mit Ihrer Systemwelt. Wir verbinden HubSpot sauber und wartbar — mit definierter Sync-Richtung, Authentifizierung und Monitoring.',
    bullets: ['ERP, DATEV, SAP, Abrechnung & Lizenzmanagement', 'Make, n8n, Zapier oder individuell entwickelte APIs', 'OAuth/Least-Privilege, Fehler-Handling & Monitoring'],
  },
];

const itCards = [
  { title: 'IT-Projekte', copy: 'Solution Architecture & Design, IT-Systemanalyse, Datenintegration & -management, Schnittstellen und Workflow-Automatisierung — dieselbe Tiefe, über HubSpot hinaus.' },
  { title: 'IT-Struktur & Betrieb', copy: 'Managed IT für den Mittelstand (50–500 Arbeitsplätze): Microsoft 365, IT-Sicherheit & Compliance, Support und Netzwerk — im Satelliten-Modell, das Ihr internes Team stärkt statt ersetzt.' },
];

const tiers = [
  { num: '01', name: 'Essential', who: 'Für den klaren Einstieg', copy: 'Fokussierte Umsetzung mit schnellem Nutzen. Projekt- oder ticketbasiert, ohne langfristige Bindung.' },
  { num: '02', name: 'Advanced', who: 'Für aktive Weiterentwicklung', copy: 'Workshops, laufende Optimierung und regelmäßige Reviews. Empfohlen als Quartals- oder Jahres-Retainer.' },
  { num: '03', name: 'Excellence', who: 'Für komplexe Setups', copy: 'Individuelle Strategieberatung, technische Tiefe und SLA-basierter Support für mehrere Teams und Integrationen.' },
];

const steps = [
  { n: '01', w: 'Woche 1', t: 'Discovery', d: 'Prozesse, Daten, Stakeholder und Ziele.' },
  { n: '02', w: 'Woche 2–3', t: 'Konzept', d: 'Datenmodell, Pipelines, Module.' },
  { n: '03', w: 'Woche 4–6', t: 'Build', d: 'Setup, Migration, Integrationen.', active: true },
  { n: '04', w: 'Woche 7', t: 'Enablement', d: 'Schulung & Admin-Coaching.' },
  { n: '05', w: 'Woche 8', t: 'Go-Live', d: 'Hypercare & Reporting.' },
];

const faqs = [
  { q: 'Bei welchen Fragestellungen unterstützt CogniCore?', a: 'Von der strategischen HubSpot-Einführung über die Prozessoptimierung bis zur Integration in Ihre Systemlandschaft — wir begleiten Sie da, wo Sie gerade stehen.' },
  { q: 'Wie läuft ein Projekt konkret ab?', a: 'In fünf Etappen: Discovery, Konzept, Build, Enablement, Go-Live. Jede Phase hat definierte Deliverables und feste Ansprechpartner — ein typischer HubSpot-Einstieg ist in rund acht Wochen produktiv.' },
  { q: 'Wie integrieren Sie HubSpot technisch in bestehende Systeme?', a: 'Über native Konnektoren, Middleware (z. B. Make/n8n) oder individuell entwickelte REST-/Webhook-Schnittstellen. Sync-Richtung, Authentifizierung (OAuth, Least-Privilege), Fehler-Handling und Monitoring werden vorab sauber definiert und dokumentiert.' },
  { q: 'Wie halten Sie es mit Datenschutz und Datenhaltung?', a: 'Wir arbeiten nach DSGVO-Prinzipien: EU-Datenhaltung wo möglich, minimale Berechtigungen für Integrationen und dokumentierte Datenflüsse. Als HubSpot-Partner setzen wir auch die datenschutzkonforme Konfiguration Ihres Portals um.' },
  { q: 'Warum ist die Kombination von CRM und Marketing Automation wichtig?', a: 'Weil sie Silos aufbricht: Daten, Prozesse und Teams arbeiten zusammen — für bessere Kundenerlebnisse und messbaren Vertriebserfolg.' },
  { q: 'Welche Stufe ist die richtige für uns?', a: 'Im Erstgespräch klären wir Ziele, HubSpot-Reifegrad und Ressourcenlage. Daraus leiten wir ab, ob Essential genügt oder Advanced bzw. Excellence den größeren Mehrwert bringt.' },
  { q: 'Können wir später in eine höhere Stufe wechseln?', a: 'Ja. Alle Stufen bauen aufeinander auf — Sie können jederzeit upgraden, bestehende Einstellungen und Daten bleiben vollständig erhalten.' },
  { q: 'Gibt es Mindestlaufzeiten?', a: 'Essential läuft projekt- oder ticketbasiert ohne langfristige Bindung. Für Advanced und Excellence empfehlen wir Retainer mit fairen Kündigungsfristen.' },
  { q: 'Was kostet das?', a: 'Konkrete Preise nennen wir transparent im Erstgespräch — abhängig von Umfang und Reifegrad. Der Self-Check und das Erstgespräch sind kostenlos und unverbindlich.' },
];
---
<Base active="leistungen" title="HubSpot-Leistungen: Onboarding, Integration & Managed IT | CogniCore Köln" description="HubSpot Onboarding, Begleitung & Optimierung sowie Prozess- und API-Integration — plus IT-Projekte und Managed IT. Im Drei-Stufen-Modell Essential, Advanced und Excellence.">
  <!-- HERO -->
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"><img src="/brand/cognicore-icon-white.png" alt="" /></div>
    <div class="cc-hero__inner" style="grid-template-columns:1fr; padding-bottom:64px">
      <div class="cc-hero__copy" style="max-width:760px">
        <div class="cc-eyebrow">// Leistungen</div>
        <h1 class="cc-hero__title" style="font-size:56px">HubSpot — und die <em>Tiefe</em> dahinter.</h1>
        <p class="cc-hero__lede">Modulare Lösungen mit wachsendem Leistungsumfang: vom sauberen Onboarding über die laufende Optimierung bis zur Prozess- und API-Integration. Und wenn Sie mehr brauchen, die IT dahinter.</p>
      </div>
    </div>
  </section>

  <!-- HUBSPOT-SÄULEN (Feature-Splits) -->
  <section class="cc-section">
    {pillars.map((p, i) => (
      <div class={`cc-split cc-reveal${p.rev ? ' rev' : ''}`} id={p.id} style={i > 0 ? 'margin-top:72px' : ''}>
        <div class="cc-split__body">
          <div class="cc-eyebrow">{p.ey}</div>
          <h2 style="font-size:32px; margin-top:8px">{p.title}</h2>
          <p>{p.copy}</p>
          <ul class="cc-checks">{p.bullets.map((b) => <li set:html={check + ' ' + b} />)}</ul>
        </div>
        <div class="cc-split__media"><img src={p.img} alt={p.title} width="640" height="480" loading="lazy" /></div>
      </div>
    ))}
  </section>

  <!-- UND MEHR: IT-TIEFE -->
  <section class="cc-section cc-section--beige">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">// Und mehr</div>
      <h2>Nicht nur HubSpot. Die IT dahinter.</h2>
      <p class="cc-section__sub">CogniCore ist HubSpot-first — aber wir denken die gesamte IT mit. Für Häuser, die einen Partner für mehr als das CRM suchen.</p>
    </div>
    <div class="cc-grid cc-grid--2 cc-reveal">
      {itCards.map((c) => (
        <article class="cc-card"><h3>{c.title}</h3><p>{c.copy}</p></article>
      ))}
    </div>
  </section>

  <!-- VORGEHEN -->
  <section class="cc-section cc-section--surface">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">// Vorgehen</div>
      <h2>Vom Kick-off zum Go-Live in fünf Etappen.</h2>
    </div>
    <div class="cc-process cc-reveal">
      <div class="cc-process__line" aria-hidden="true"></div>
      {steps.map((s) => (
        <div class={`cc-process__step${s.active ? ' is-active' : ''}`}>
          <div class="cc-process__dot">{s.n}</div><div class="cc-process__week">{s.w}</div><h3>{s.t}</h3><p>{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- STUFENMODELL -->
  <section class="cc-section">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">// Modell</div>
      <h2>Starten Sie auf dem passenden Niveau.</h2>
      <p class="cc-section__sub">Ein Drei-Stufen-Modell, das mit Ihren Zielen wächst. Konkrete Preise besprechen wir transparent im kostenlosen Erstgespräch — abhängig von Umfang und Reifegrad.</p>
    </div>
    <div class="cc-grid cc-grid--3 cc-reveal">
      {tiers.map((t) => (
        <article class="cc-card"><div class="cc-card__num">{t.num}</div><h3>{t.name}</h3><p style="color:var(--cc-orange); font-weight:600; font-size:13px; margin:-4px 0 0">{t.who}</p><p>{t.copy}</p></article>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="cc-section cc-section--surface">
    <div class="cc-section__head center cc-reveal"><div class="cc-eyebrow">// FAQ</div><h2>Häufige Fragen.</h2></div>
    <div class="cc-legal" style="max-width:840px">
      {faqs.map((f) => (
        <details style="border-bottom:1px solid var(--cc-line)">
          <summary style="list-style:none; cursor:pointer; display:flex; justify-content:space-between; gap:16px; padding:20px 4px; font-family:var(--cc-font-display); font-weight:600; font-size:18px; color:var(--cc-blue)">{f.q}<span style="color:var(--cc-orange)">+</span></summary>
          <p style="padding:0 4px 20px; color:var(--cc-fg-2); font-size:15.5px; max-width:74ch">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cc-contact" id="termin">
    <div class="cc-contact__left" style="max-width:none; justify-self:stretch; padding-left:56px">
      <div class="cc-eyebrow cc-eyebrow--on-dark">// Nächster Schritt</div>
      <h2>Lassen Sie uns über Ihr <em>HubSpot</em> sprechen.</h2>
      <p>Ein Erstgespräch, 30 Minuten, kein Pitch. Wir sagen ehrlich, ob und wie wir helfen können.</p>
      <div style="margin-top:24px; display:flex; gap:12px; flex-wrap:wrap">
        <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
        <a class="cc-btn cc-btn--ghost-light" href="/kontakt">Zur Kontaktseite</a>
      </div>
    </div>
    <aside class="cc-contact__right">
      <div class="cc-contact__card">
        <img src="/brand/cognicore-icon-white-orange.png" alt="" />
        <h3>Kurzer Draht</h3>
        <dl>
          <dt>Telefon</dt><dd><a href="tel:+4922165053000">+49 221 6505 3000</a></dd>
          <dt>E-Mail</dt><dd><a href="mailto:info@cognicore.de">info@cognicore.de</a></dd>
          <dt>Büro</dt><dd>Im Mediapark 6B<br/>50670 Köln</dd>
        </dl>
      </div>
    </aside>
  </section>
</Base>
