---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Preisleiter from '../components/Preisleiter.astro';
import { saeulen, inSaeule } from '../data/leistungen';

const tiers = [
  { num: '01', name: 'Essential', who: 'Für den klaren Einstieg', copy: 'Fokussierte Umsetzung mit schnellem Nutzen. Projekt- oder ticketbasiert, ohne langfristige Bindung.',
    price: 'ab 4.900 €', unit: 'einmalig für die Einführung', note: 'Mit Datenübernahme aus einem Altsystem ab 9.500 €.' },
  { num: '02', name: 'Advanced', who: 'Für aktive Weiterentwicklung', copy: 'Workshops, laufende Optimierung und regelmäßige Reviews. Empfohlen als Quartals- oder Jahres-Retainer.',
    price: 'ab 850 €', unit: 'im Monat', note: '5 Stunden im Monat, feste Ansprechpartner.' },
  { num: '03', name: 'Excellence', who: 'Für komplexe Setups', copy: 'Individuelle Strategieberatung, technische Tiefe und SLA-basierter Support für mehrere Teams und Integrationen.',
    price: 'ab 2.900 €', unit: 'im Monat', note: '16 Stunden im Monat, mit SLA.' },
];

const steps = [
  { n: '01', w: 'Woche 1', t: 'Discovery', d: 'Prozesse, Daten, Stakeholder und Ziele.' },
  { n: '02', w: 'Woche 2 bis 3', t: 'Konzept', d: 'Datenmodell, Pipelines, Module.' },
  { n: '03', w: 'Woche 4 bis 6', t: 'Build', d: 'Setup, Migration, Integrationen.', active: true },
  { n: '04', w: 'Woche 7', t: 'Enablement', d: 'Schulung und Admin-Coaching.' },
  { n: '05', w: 'Woche 8', t: 'Go-Live', d: 'Hypercare und Reporting.' },
];

const faqs = [
  { q: 'Bei welchen Fragestellungen unterstützt CogniCore?', a: 'Bei der Einführung und Betreuung von HubSpot, bei Schnittstellen zu Ihren übrigen Systemen, beim Betrieb von Microsoft 365 und beim Einsatz von KI in diesen Systemen. Wir steigen da ein, wo Sie gerade stehen.' },
  { q: 'Wie läuft ein Projekt konkret ab?', a: 'In fünf Etappen: Discovery, Konzept, Build, Enablement, Go-Live. Jede Phase hat definierte Ergebnisse und feste Ansprechpartner. Ein typischer HubSpot-Einstieg ist in rund acht Wochen produktiv.' },
  { q: 'Wie integrieren Sie HubSpot technisch in bestehende Systeme?', a: 'Über native Konnektoren, Middleware wie Make oder n8n oder individuell entwickelte Schnittstellen. Sync-Richtung, Authentifizierung, Fehlerbehandlung und Überwachung legen wir vorab fest und dokumentieren sie.' },
  { q: 'Wie halten Sie es mit Datenschutz und Datenhaltung?', a: 'Wir arbeiten nach DSGVO-Prinzipien: EU-Datenhaltung wo möglich, minimale Berechtigungen für Integrationen und dokumentierte Datenflüsse. Als HubSpot-Partner setzen wir auch die datenschutzkonforme Konfiguration Ihres Portals um.' },
  { q: 'Warum HubSpot und Microsoft 365 aus einer Hand?', a: 'Weil Anmeldung, Berechtigungen, Mail, Kalender und Ablage beide Systeme betreffen. Wer beide Seiten betreut, kann diese Fragen in einem Zug lösen.' },
  { q: 'Welche Stufe ist die richtige für uns?', a: 'Im Erstgespräch klären wir Ziele, HubSpot-Reifegrad und Ressourcen. Daraus leiten wir ab, ob Essential genügt oder Advanced oder Excellence den größeren Mehrwert bringt.' },
  { q: 'Können wir später in eine höhere Stufe wechseln?', a: 'Ja. Alle Stufen bauen aufeinander auf. Bestehende Einstellungen und Daten bleiben vollständig erhalten.' },
  { q: 'Was kostet das?', a: 'Eine HubSpot-Einführung ohne Datenübernahme startet bei 4.900 € netto, mit Migration aus einem Altsystem bei 9.500 €. Der laufende Betrieb läuft als Stundenkontingent: Advanced ab 850 € im Monat für 5 Stunden, Excellence ab 2.900 € im Monat für 16 Stunden mit SLA. Die Einstiegsprodukte und ihre Preise stehen oben in der Übersicht. Die HubSpot-Lizenzen zahlen Sie direkt an HubSpot.' },
];

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base active="leistungen" title="Leistungen: HubSpot, Integration, Microsoft 365 und KI | CogniCore Köln" description="HubSpot-Einführung, Audit und Managed Service, Schnittstellen und Microsoft-365-Integration, IT-Betrieb und KI. Mit festen Einstiegspreisen, Einführung ab 4.900 €.">
  <!-- HERO -->
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"><img src="/brand/cognicore-icon-white.png" alt="" /></div>
    <div class="cc-hero__inner" style="grid-template-columns:1fr; padding-bottom:64px">
      <div class="cc-hero__copy" style="max-width:780px">
        <div class="cc-eyebrow">Leistungen</div>
        <h1 class="cc-hero__title" style="font-size:56px">Von HubSpot bis zum <em style="white-space:nowrap">IT-Betrieb</em>.</h1>
        <p class="cc-hero__lede">Wir führen HubSpot ein, verbinden es mit Ihren Systemen, betreiben die Microsoft-Umgebung dahinter und setzen KI dort ein, wo Ihre Daten liegen.</p>
        <div class="cc-hero__actions" style="margin-bottom:0">
          {saeulen.map((s) => <a class="cc-btn cc-btn--ghost-light" href={`#${s.key}`}>{s.title}</a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- SÄULEN -->
  <section class="cc-section">
    {saeulen.map((s) => (
      <div class="cc-saeule cc-reveal" id={s.key}>
        <div class="cc-saeule__head">
          <div>
            <div class="cc-eyebrow">{s.ey}</div>
            <h2>{s.title}</h2>
            <p>{s.intro}</p>
          </div>
        </div>
        <div class="cc-grid cc-grid--3">
          {inSaeule(s.key).map((l) => (
            <article class="cc-card">
              <h3>{l.nav}</h3>
              <p>{l.kurz}</p>
              <p style="font-family:var(--cc-font-display); font-weight:700; color:var(--cc-blue); font-size:14px; margin-top:4px">{l.preis.wert}{l.preis.einheit ? ` ${l.preis.einheit}` : ''}</p>
              <a class="cc-card__link" href={`/leistungen/${l.slug}`}>Mehr erfahren →</a>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- PREISLEITER -->
  <Preisleiter surface />

  <!-- VORGEHEN -->
  <section class="cc-section">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">Vorgehen</div>
      <h2>Vom Kick-off zum Go-Live in fünf Etappen.</h2>
    </div>
    <div class="cc-process cc-reveal">
      <div class="cc-process__line" aria-hidden="true"></div>
      {steps.map((s) => (
        <div class={`cc-process__step${s.active ? ' is-active' : ''}`}>
          <div class="cc-process__dot">{s.n}</div><div class="cc-process__week">{s.w}</div><h3>{s.t}</h3><p>{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- STUFENMODELL -->
  <section class="cc-section cc-section--surface">
    <div>
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">Modell</div>
      <h2>Starten Sie auf dem passenden Niveau.</h2>
      <p class="cc-section__sub">Ein Drei-Stufen-Modell für HubSpot, das mit Ihren Zielen wächst. Was Ihr Fall kostet, hängt vor allem daran, ob Daten aus einem Altsystem übernommen werden. Den verbindlichen Festpreis bekommen Sie vor Projektstart.</p>
    </div>
    <div class="cc-grid cc-grid--3 cc-reveal">
      {tiers.map((t) => (
        <article class="cc-card"><div class="cc-card__num">{t.num}</div><h3>{t.name}</h3><p style="color:var(--cc-orange-ink); font-weight:600; font-size:13px; margin:-4px 0 0">{t.who}</p><p>{t.copy}</p>
          <div style="margin-top:auto; padding-top:16px; border-top:1px solid var(--cc-line)">
            <p style="font-family:var(--cc-font-display); font-weight:700; font-size:26px; color:var(--cc-blue); margin:0; line-height:1.2">{t.price}</p>
            <p style="font-size:13px; color:var(--cc-fg-2); margin:2px 0 0">{t.unit}</p>
            <p style="font-size:13.5px; color:var(--cc-fg-2); margin:8px 0 0">{t.note}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="cc-reveal" style="max-width:840px; margin:20px auto 0; text-align:center; font-size:13.5px; color:var(--cc-fg-2)">Alle Preise netto zzgl. USt. Die HubSpot-Lizenzen zahlen Sie direkt an HubSpot, unser Angebot deckt Aufbau und Betreuung ab.</p>
    </div>
  </section>

  <!-- FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="cc-section">
    <div class="cc-section__head center cc-reveal"><div class="cc-eyebrow">FAQ</div><h2>Häufige Fragen.</h2></div>
    <div class="cc-legal" style="max-width:840px">
      {faqs.map((f) => (
        <details style="border-bottom:1px solid var(--cc-line)">
          <summary style="list-style:none; cursor:pointer; display:flex; justify-content:space-between; gap:16px; padding:20px 4px; font-family:var(--cc-font-display); font-weight:600; font-size:18px; color:var(--cc-blue)">{f.q}<span style="color:var(--cc-orange)">+</span></summary>
          <p style="padding:0 4px 20px; color:var(--cc-fg-2); font-size:15.5px; max-width:74ch">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CtaBand title="Lassen Sie uns über Ihr" em="HubSpot" />
</Base>
