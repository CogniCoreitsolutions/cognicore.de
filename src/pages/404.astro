---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden (404) | CogniCore" description="Diese Seite existiert nicht.">
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"><img src="/brand/cognicore-icon-white.png" alt="" /></div>
    <div class="cc-hero__inner" style="grid-template-columns:1fr; padding-bottom:80px">
      <div class="cc-hero__copy" style="max-width:640px">
        <div class="cc-eyebrow cc-eyebrow--on-dark">// Fehler 404</div>
        <h1 class="cc-hero__title" style="font-size:56px">Diese Seite gibt es nicht (mehr).</h1>
        <p class="cc-hero__lede">Vielleicht wurde sie verschoben oder der Link ist veraltet. Springen Sie zurück zu:</p>
        <div class="cc-hero__actions">
          <a class="cc-btn cc-btn--accent" href="/">Zur Startseite</a>
          <a class="cc-btn cc-btn--ghost-light" href="/leistungen">Leistungen</a>
          <a class="cc-btn cc-btn--ghost-light" href="/kontakt">Kontakt</a>
        </div>
      </div>
    </div>
  </section>
</Base>
