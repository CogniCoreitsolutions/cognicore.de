---
import Base from '../layouts/Base.astro';

const team = [
  { name: 'Dominik', img: '/img/team-dominik.jpg' },
  { name: 'Michael', img: '/img/team-michael.jpg' },
  { name: 'Rafael', img: '/img/team-rafael.jpg' },
  { name: 'Adrian', img: '/img/team-adrian.jpg' },
];
---
<Base active="start">
  <!-- ===================== HERO ===================== -->
  <section class="hero" style="background-image:url('/img/hero.png')">
    <div class="wrap">
      <h1>Damit es <span class="u">skaliert</span>, nicht eskaliert!</h1>
      <p class="lede">
        CogniCore ist HubSpot-Partner für B2B-Unternehmen, die systematisch wachsen wollen –
        mit klaren Prozessen, skalierbarer Technologie und technischer Tiefe.
      </p>
      <a href="/kontakt" class="btn btn-primary">
        Jetzt Erstgespräch buchen
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- ===================== LEISTUNGEN ===================== -->
  <section class="section">
    <div class="wrap">
      <h2 class="reveal">Das tun wir für unsere Kunden</h2>

      <div class="svc-cards reveal">
        <article class="svc-card" style="background-image:url('/img/card-onboarding.jpg')">
          <span class="svc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/><path d="m9 14 2 2 4-4"/></svg>
          </span>
          <h3>HubSpot Onboarding</h3>
        </article>

        <article class="svc-card" style="background-image:url('/img/card-support.jpg')">
          <span class="svc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
          </span>
          <h3>HubSpot Begleitung &amp; Optimierung</h3>
        </article>

        <article class="svc-card" style="background-image:url('/img/card-integration.jpg')">
          <span class="svc-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5 8.6 10.5"/></svg>
          </span>
          <h3>Prozessintegration &amp; API-Schnittstellen</h3>
        </article>
      </div>

      <div class="svc-more">
        <a href="/leistungen" class="btn btn-primary">Hier mehr über unsere Leistungen erfahren →</a>
      </div>
    </div>
  </section>

  <!-- ===================== STUFENMODELL ===================== -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <h2 class="reveal">Skalierbare Lösungen – unser Modell für den HubSpot-Erfolg.</h2>
      <div class="tier-split reveal">
        <div>
          <p>
            Unsere Leistungen folgen einem Drei-Stufen-Modell: Essential, Advanced und Excellence.
            Damit bekommt ihr genau den Support, der zu eurer aktuellen Phase passt – vom schnellen
            Einstieg bis zur durchdachten Systemarchitektur. So wächst euer HubSpot mit euren Zielen –
            strukturiert, nachvollziehbar und jederzeit ausbaubar.
          </p>
        </div>
        <div>
          <p style="font-weight:600;color:var(--navy)">Unsere Leistungen folgen einem Drei-Stufen-Modell:</p>
          <ul class="tier-list">
            <li>
              <span class="tier-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19"/></svg></span>
              Essential
            </li>
            <li>
              <span class="tier-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg></span>
              Advanced
            </li>
            <li>
              <span class="tier-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.5 3L12 4l5.5 6L22 7l-2 12H4L2 7z"/></svg></span>
              Excellence
            </li>
          </ul>
          <p>
            So könnt ihr genau dort starten, wo es für euch passt – und jederzeit in die nächste
            Stufe wachsen, wenn Prozesse, Anforderungen oder Teams komplexer werden.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TEAM ===================== -->
  <section class="section team">
    <div class="wrap">
      <h2 class="reveal">Ein Team mit technischer Tiefe, klaren Köpfen und guter Laune.</h2>
      <p class="lead reveal">
        Wir sind ein interdisziplinäres Team aus Strateg:innen, Solution Architects und
        HubSpot-Spezialist:innen – mit einem gemeinsamen Anspruch: saubere Prozesse, skalierbare
        Systeme und ehrliche Zusammenarbeit. Unser Hauptsitz liegt im Mediapark Köln, aber wir
        arbeiten flexibel – häufig vor Ort aber auch mal verteilt auf der ganzen Welt. Was uns
        verbindet: fachliche Tiefe, klare Kommunikation und die Überzeugung, dass Technologie nur
        dann funktioniert, wenn Menschen sie verstehen und nutzen wollen.
        <a href="/ueber-uns" class="textlink">Hier mehr über uns erfahren.</a>
      </p>
      <div class="team-grid reveal">
        {team.map((m) => (
          <figure class="team-card">
            <img src={m.img} alt={`${m.name} – CogniCore Team`} width="300" height="400" loading="lazy" />
            <figcaption class="name">{m.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== KONTAKT-INTRO ===================== -->
  <section class="section contact-intro">
    <div class="wrap">
      <h2 class="reveal">Ein kurzes Gespräch, das Klarheit bringt.</h2>
      <p class="reveal">
        In einem ersten Gespräch lernen wir uns kennen, klären eure Ausgangssituation und schauen
        gemeinsam, welcher Betreuungsansatz zu euch passt – vom schnellen HubSpot-Start bis zur
        langfristigen Begleitung.
      </p>
      <p class="reveal" style="margin-top:14px">
        Du bekommst erste Impulse, wir stellen dir unser Vorgehen vor – ein Termin, kein Pitch.
        Ganz ohne Verkaufsdruck. Dafür mit echtem Interesse an eurem Fortschritt.
      </p>
    </div>
  </section>

  <!-- ===================== KONTAKTFORMULAR ===================== -->
  <section class="section contact-form-sec" id="talk">
    <div class="wrap">
      <h2 class="reveal">Jetzt einfach kontaktieren</h2>
      <!-- TODO: an HubSpot Forms API (Portal 144804770, EU) anbinden -->
      <form class="form-card reveal" method="post" action="#">
        <div class="form-row">
          <div class="field">
            <label for="vorname">Vorname*</label>
            <input id="vorname" name="firstname" type="text" required />
          </div>
          <div class="field">
            <label for="nachname">Nachname*</label>
            <input id="nachname" name="lastname" type="text" required />
          </div>
        </div>
        <div class="field">
          <label for="email">E-Mail*</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="telefon">Telefonnummer</label>
          <input id="telefon" name="phone" type="tel" />
        </div>
        <div class="field">
          <label for="nachricht">Nachricht*</label>
          <textarea id="nachricht" name="message" required></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="newsletter" />
          <span>Ja, ich möchte zusätzlich regelmäßig die CogniCore-News mit Insights, Tipps und Angeboten per E-Mail erhalten.</span>
        </label>
        <p class="consent" style="margin-bottom:20px">
          Mit dem Absenden dieses Formulars erklärst du dich einverstanden, dass CogniCore deine
          Angaben verarbeitet, um dir den angeforderten Inhalt bereitzustellen und dir relevante
          Informationen zu senden. Du kannst deine Einwilligung jederzeit widerrufen. Mehr dazu in
          unserer <a href="/datenschutz">Datenschutzerklärung</a>.
        </p>
        <button type="submit" class="btn btn-primary">Absenden</button>
      </form>
    </div>
  </section>
</Base>
