---
import Base from '../layouts/Base.astro';
import Preisleiter from '../components/Preisleiter.astro';
import CtaBand from '../components/CtaBand.astro';
import { bySlug } from '../data/leistungen';

// Startseite in Gestaltung A · Sachlich (Entwurf vom 01.10.2026)
const saeulen = [
  { t: 'HubSpot', d: 'Einführung, Migration, Audit, Individualentwicklung und feste Betreuung Ihres Portals.', href: '/leistungen#hubspot' },
  { t: 'Daten und Integration', d: 'Schnittstellen zu ERP, Buchhaltung und Microsoft 365, die wir nach dem Go-live auch betreiben.', href: '/leistungen#daten' },
  { t: 'Microsoft 365 und IT-Betrieb', d: 'Microsoft 365, Geräte, Sicherheit und Backup im Servicevertrag mit festen Reaktionszeiten.', href: '/leistungen#microsoft' },
  { t: 'KI', d: 'KI-Audit mit laufendem Pilot, KI-Agenten in HubSpot und Copilot mit Ihren CRM-Daten.', href: '/leistungen#ki' },
];

const fakten = [
  { n: '16', l: 'Kunden seit Juni 2024' },
  { n: '11', l: 'davon arbeiten mit HubSpot' },
  { n: '43', l: 'Projekte abgerechnet' },
  { n: '8', l: 'eigene Anwendungen seit April 2026' },
];

// Termine kommen aus derselben Quelle wie die Buchungsseite
const wochentage = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'];
const heute = new Date().toISOString().slice(0, 10);
const termine = (bySlug('hubspot-gruppen-onboarding')?.termine ?? [])
  .filter((t) => t.datum >= heute)
  .map((t) => {
    const [y, m, d] = t.datum.split('-');
    return { ...t, tag: wochentage[new Date(Date.UTC(+y, +m - 1, +d)).getUTCDay()], anzeige: `${d}.${m}.${y}` };
  });

const itPunkte = [
  'Der Vertrag als eigenes Objekt',
  'Kontingentverbrauch je Vertrag',
  'PSA und RMM am Kunden',
  'Eingerichtet von einem IT-Dienstleister',
];

const team = [
  { name: 'Dominik Siegers', role: 'Geschäftsführung, Vertrieb, INQA-Coach', img: '/img/team-dominik.jpg' },
  { name: 'Rafael Garoz Garcia', role: 'HubSpot- und RevOps-Beratung', img: '/img/team-rafael.jpg' },
  { name: 'Adrian Geiss', role: 'Technik und Entwicklung', img: '/img/team-adrian.jpg' },
  { name: 'Arijan Vossough', role: 'Support und Managed Services', initials: 'AV' },
];
---
<Base active="start" title="HubSpot-Partner für den Microsoft-geprägten Mittelstand | CogniCore Köln" description="CogniCore führt HubSpot ein, verbindet es mit Ihren Systemen und betreibt die Microsoft-Umgebung dahinter. HubSpot Solutions Partner aus dem Mediapark Köln, Preise vorab.">

  <!-- Seitenkopf -->
  <section class="cc-wrap cc-a-hero">
    <div class="cc-a-hero__copy">
      <p class="cc-a-kicker">CogniCore IT Solutions, Mediapark Köln</p>
      <h1>HubSpot für den Mittelstand, der mit Microsoft arbeitet.</h1>
      <p class="cc-a-lede">Wir führen HubSpot ein, verbinden es mit Ihren Systemen und betreiben die Microsoft-Umgebung dahinter. Wir sind vier Leute in Köln, und unsere Preise stehen vorher fest.</p>
      <div class="cc-a-actions">
        <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
        <a class="cc-a-link" href="#einstieg">Preise ansehen</a>
      </div>
    </div>
    <figure class="cc-a-figure">
      <img src="/img/card-integration.jpg" alt="Dominik Siegers am Laptop im Besprechungsraum" width="1100" height="834" />
      <figcaption>Dominik Siegers, Geschäftsführer, im Büro im Mediapark.</figcaption>
    </figure>
  </section>

  <!-- Fakten -->
  <section class="cc-a-facts">
    <div class="cc-wrap cc-a-facts__grid">
      {fakten.map((f) => (
        <div><span class="cc-a-facts__num">{f.n}</span><span class="cc-a-facts__label">{f.l}</span></div>
      ))}
    </div>
    <p class="cc-wrap cc-a-facts__note">Stand September 2026, aus unserer Zeiterfassung. Eine Unternehmensgruppe zählt einmal.</p>
  </section>

  <!-- 1 Leistungen -->
  <section class="cc-wrap cc-a-sec" id="leistungen">
    <p class="cc-a-sec__label">1 Leistungen</p>
    <div class="cc-a-sec__body">
      <h2 style="margin-bottom:32px">Vier Bereiche, ein Team.</h2>
      <div class="cc-a-rows">
        {saeulen.map((s) => (
          <a class="cc-a-row" href={s.href}>
            <span class="cc-a-row__title">{s.t}</span>
            <span class="cc-a-row__text">{s.d}</span>
          </a>
        ))}
      </div>
      <p class="cc-a-note" style="font-size:15px">Wenn der Standard Ihren Fall nicht wirtschaftlich abdeckt, bauen wir die Anwendung selbst. <a class="cc-a-link" href="/loesungen">Zu unseren Lösungen</a></p>
    </div>
  </section>

  <!-- 2 Preise -->
  <Preisleiter nummer="2" />

  <!-- 3 Termine -->
  <section class="cc-wrap cc-a-sec">
    <p class="cc-a-sec__label">3 Termine</p>
    <div class="cc-a-sec__body">
      <h2>Gruppen-Onboarding, die nächsten Termine.</h2>
      <p class="cc-a-sec__intro">Jeweils dienstags von 14:00 bis 15:30 über Microsoft Teams, 290 € je Unternehmen.</p>
      <div class="cc-a-dates">
        {termine.map((t) => (
          <div class="cc-a-date" data-datum={t.datum}>
            <span class="cc-a-date__day">{t.tag}</span>
            <span class="cc-a-date__date">{t.anzeige}</span>
            <a class="cc-a-link" href="/leistungen/hubspot-gruppen-onboarding#termine" style="font-size:15px; align-self:flex-start">Jetzt buchen</a>
          </div>
        ))}
      </div>
      <a class="cc-a-link" href="/leistungen/hubspot-gruppen-onboarding#termine" style="margin-top:18px; font-size:15px; align-self:flex-start">Alle Termine</a>
      <script is:inline>
        (function () {
          var d = new Date();
          var heute = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          document.querySelectorAll('.cc-a-date').forEach(function (el) {
            if (el.getAttribute('data-datum') < heute) el.remove();
          });
        })();
      </script>
    </div>
  </section>

  <!-- 4 IT-Dienstleister -->
  <section class="cc-wrap cc-a-sec">
    <p class="cc-a-sec__label">4 Für IT-Dienstleister</p>
    <div class="cc-a-sec__body" style="gap:20px">
      <h2 style="margin:0">Gebaut für Serviceverträge.</h2>
      <p class="cc-a-sec__intro" style="margin:0">Wir betreiben selbst Microsoft 365 für Kunden. Deshalb richten wir HubSpot für IT-Dienstleister um Verträge herum ein: Laufzeit, Kontingent und Verlängerung, angebunden an Ihr PSA- oder RMM-System.</p>
      <ol class="cc-a-list">
        {itPunkte.map((p, i) => <li><span>{i + 1}</span><span>{p}</span></li>)}
      </ol>
      <a class="cc-a-link" href="/branchen/it-dienstleister" style="align-self:flex-start">Das Setup für IT-Dienstleister ansehen</a>
    </div>
  </section>

  <!-- 5 Team -->
  <section class="cc-wrap cc-a-sec" style="padding-bottom:96px">
    <p class="cc-a-sec__label">5 Team</p>
    <div class="cc-a-sec__body" style="gap:28px">
      <h2 style="margin:0">Mit wem Sie arbeiten.</h2>
      <div class="cc-a-team">
        {team.map((m) => (
          <figure>
            {m.img
              ? <img src={m.img} alt={m.name} width="240" height="240" loading="lazy" />
              : <div class="cc-a-team__ph" aria-hidden="true">{m.initials}</div>}
            <figcaption><b>{m.name}</b><span>{m.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="Nächster Schritt" text="30 Minuten. Wir schauen gemeinsam auf Ihr System und sagen Ihnen ehrlich, ob und wie wir helfen können." />
</Base>
