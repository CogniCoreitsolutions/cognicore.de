---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { leistungen, saeulen, bySlug, type Leistung } from '../../data/leistungen';

export function getStaticPaths() {
  return leistungen.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props as { l: Leistung };
const saeule = saeulen.find((s) => s.key === l.saeule)!;
const related = l.related.map(bySlug).filter(Boolean) as Leistung[];
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: l.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
// Buchbare Termine: vergangene fallen beim Build und im Browser raus
const heute = new Date().toISOString().slice(0, 10);
const wochentage = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'];
const ort = l.terminOrt ?? 'online';
const titel = l.terminTitel ?? l.nav;
const termine = (l.termine ?? []).filter((t) => t.datum >= heute).map((t) => {
  const [y, m, d] = t.datum.split('-');
  const tag = wochentage[new Date(Date.UTC(+y, +m - 1, +d)).getUTCDay()];
  const anzeige = `${d}.${m}.${y}`;
  const betreff = `Buchung ${titel} am ${anzeige}`;
  const text = [
    'Hallo CogniCore-Team,',
    '',
    `wir buchen das ${titel} am ${tag}, ${anzeige}, von ${t.von} bis ${t.bis} Uhr (${ort}) zum Preis von ${l.preis.wert} netto ${l.preis.einheit ?? ''}.`.replace(/ \./, '.'),
    '',
    'Unternehmen:',
    'Rechnungsadresse:',
    'USt-IdNr. (falls vorhanden):',
    'Ansprechpartner:',
    'Teilnehmende (Name und E-Mail):',
    '',
    'Die Storno-Regel ist uns bekannt: kostenlos umbuchen bis drei Werktage vorher, danach keine Erstattung.',
    '',
    'Viele Grüße',
  ].join('\n');
  const href = t.zahlungslink ?? `mailto:info@cognicore.de?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(text)}`;
  return { ...t, tag, anzeige, href, extern: Boolean(t.zahlungslink) };
});
const perMail = termine.some((t) => !t.extern);

const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: l.nav, description: l.lede, serviceType: saeule.title,
  provider: { '@type': 'ProfessionalService', name: 'CogniCore IT Solutions GmbH', url: 'https://cognicore.de' },
  areaServed: ['DE', 'AT', 'CH'],
};
---
<Base active="leistungen" title={l.seoTitle} description={l.seoDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- HERO -->
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"><img src="/brand/cognicore-icon-white.png" alt="" /></div>
    <div class="cc-hero__inner" style="grid-template-columns:1fr; padding-bottom:72px">
      <div class="cc-hero__copy" style="max-width:820px">
        <div class="cc-crumbs"><a href="/leistungen">Leistungen</a> / <a href={`/leistungen#${saeule.key}`}>{saeule.title}</a></div>
        <div class="cc-eyebrow">{saeule.ey}</div>
        <h1 class="cc-hero__title" style="font-size:52px">{l.title}</h1>
        <p class="cc-hero__lede" style="max-width:680px">{l.lede}</p>
        <div class="cc-hero__actions" style="margin-bottom:0">
          <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
          {l.extern
            ? <a class="cc-btn cc-btn--ghost-light" href={l.extern.href} target="_blank" rel="noopener">{l.extern.label} ↗</a>
            : termine.length > 0
              ? <a class="cc-btn cc-btn--ghost-light" href="#termine">Termine ansehen</a>
              : <a class="cc-btn cc-btn--ghost-light" href="#preis">Preis ansehen</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- TERMINE (nur wenn buchbare Termine gepflegt sind) -->
  {l.termine && l.termine.length > 0 && (
    <section class="cc-section" id="termine">
      <div class="cc-section__head cc-reveal">
        <div class="cc-eyebrow">Termine</div>
        <h2>Termin wählen und buchen.</h2>
        <p class="cc-section__sub">{l.preis.wert} netto {l.preis.einheit}, online über {ort}.</p>
      </div>
      <div class="cc-grid cc-grid--3 cc-reveal">
        {termine.map((t) => (
          <article class="cc-card cc-termin" data-datum={t.datum}>
            <span class="cc-termin__tag">{t.tag}</span>
            <span class="cc-termin__datum">{t.anzeige}</span>
            <span class="cc-termin__zeit">{t.von} bis {t.bis} Uhr · {ort}</span>
            <a class="cc-btn cc-btn--accent" href={t.href} target={t.extern ? '_blank' : undefined} rel={t.extern ? 'noopener' : undefined}>Jetzt buchen</a>
          </article>
        ))}
      </div>
      <p class="cc-termine__leer" hidden={termine.length > 0}>Die nächsten Termine veröffentlichen wir in Kürze. Schreiben Sie uns gern an <a class="cc-textlink" href="mailto:info@cognicore.de">info@cognicore.de</a>.</p>
      <p class="cc-ladder__foot cc-reveal">
        {perMail
          ? <>Mit „Jetzt buchen“ öffnet sich eine vorbereitete E-Mail an <a class="cc-textlink" href="mailto:info@cognicore.de">info@cognicore.de</a>. Sie bekommen eine Bestätigung mit Rechnung und vor dem Termin den Teams-Link.</>
          : <>Mit „Jetzt buchen“ kommen Sie zur sicheren Zahlung. Danach bekommen Sie eine Bestätigung und vor dem Termin den Teams-Link.</>}
        {' '}Kostenlos umbuchen bis drei Werktage vorher, danach keine Erstattung. Buchbar nur für Unternehmen.
      </p>
      <script is:inline>
        (function () {
          var d = new Date();
          var heute = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          var offen = 0;
          document.querySelectorAll('.cc-termin').forEach(function (el) {
            if (el.getAttribute('data-datum') < heute) el.remove(); else offen++;
          });
          var leer = document.querySelector('.cc-termine__leer');
          if (leer && offen === 0) leer.hidden = false;
        })();
      </script>
    </section>
  )}

  <!-- WORUM ES GEHT / FÜR WEN -->
  <section class="cc-section">
    <div class="cc-split cc-reveal" style="align-items:start">
      <div class="cc-split__body">
        <div class="cc-eyebrow">Worum es geht</div>
        {l.kontext.map((p, i) => <p style={i === 0 ? 'font-size:19px; color:var(--cc-blue); margin-top:12px' : 'font-size:16.5px'}>{p}</p>)}
      </div>
      <div class="cc-card">
        <div class="cc-eyebrow">Für wen</div>
        <ul class="cc-checks" style="margin-top:6px">{l.fuerWen.map((b) => <li set:html={check + ' ' + b} />)}</ul>
      </div>
    </div>
  </section>

  <!-- ABLAUF -->
  <section class="cc-section cc-section--surface">
    <div>
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">Ablauf</div>
      <h2>So gehen wir vor.</h2>
    </div>
    <div class="cc-steps cc-reveal">
      {l.ablauf.map((s, i) => (
        <article class={`cc-card${i === l.ablauf.length - 1 ? ' cc-card--orange' : ''}`}>
          <div class="cc-card__num">{String(i + 1).padStart(2, '0')}</div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </article>
      ))}
    </div>
    </div>
  </section>

  <!-- ERGEBNIS + PREIS -->
  <section class="cc-section" id="preis">
    <div class="cc-grid cc-grid--2 cc-reveal" style="align-items:start; gap:40px">
      <div>
        <div class="cc-eyebrow">Ergebnis</div>
        <h2 style="font-size:34px; color:var(--cc-blue); margin-top:8px">Was Sie bekommen.</h2>
        <ul class="cc-checks">{l.ergebnis.map((b) => <li set:html={check + ' ' + b} />)}</ul>
      </div>
      <div class="cc-price">
        <div class="cc-eyebrow cc-eyebrow--on-dark">Preis</div>
        <p class="cc-price__wert">{l.preis.wert}</p>
        {l.preis.einheit && <p class="cc-price__einheit">{l.preis.einheit}</p>}
        {l.preis.hinweis && <p class="cc-price__hinweis">{l.preis.hinweis}</p>}
        <p class="cc-price__fuss">Alle Preise netto zzgl. USt. Den verbindlichen Festpreis erhalten Sie vor dem Start.</p>
        {l.extern
          ? <a class="cc-btn cc-btn--accent" href={l.extern.href} target="_blank" rel="noopener">{l.extern.label} ↗</a>
          : <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {l.faq.length > 0 && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      <section class="cc-section cc-section--surface">
        <div class="cc-section__head center cc-reveal"><div class="cc-eyebrow">FAQ</div><h2>Häufige Fragen.</h2></div>
        <div class="cc-legal" style="max-width:840px">
          {l.faq.map((f) => (
            <details style="border-bottom:1px solid var(--cc-line)">
              <summary style="list-style:none; cursor:pointer; display:flex; justify-content:space-between; gap:16px; padding:20px 4px; font-family:var(--cc-font-display); font-weight:600; font-size:18px; color:var(--cc-blue)">{f.q}<span style="color:var(--cc-orange)">+</span></summary>
              <p style="padding:0 4px 20px; color:var(--cc-fg-2); font-size:15.5px; max-width:74ch">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </>
  )}

  <!-- PASST DAZU -->
  <section class="cc-section">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">Passt dazu</div>
      <h2>Was oft zusammen gebraucht wird.</h2>
    </div>
    <div class="cc-grid cc-grid--3 cc-reveal">
      {related.map((r) => (
        <article class="cc-card">
          <div class="cc-eyebrow">{saeulen.find((s) => s.key === r.saeule)?.title}</div>
          <h3>{r.nav}</h3>
          <p>{r.kurz}</p>
          <a class="cc-card__link" href={`/leistungen/${r.slug}`}>Ansehen →</a>
        </article>
      ))}
    </div>
  </section>

  <CtaBand title="Lassen Sie uns über Ihr" em="Vorhaben" />
</Base>
