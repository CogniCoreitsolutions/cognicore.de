---
import Base from '../layouts/Base.astro';

const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

const team = [
  { name: 'Dominik Siegers', role: 'Gründer & Geschäftsführer', img: '/img/team-dominik.jpg' },
  { name: 'Michael Lohmar', role: 'Gründer & Geschäftsführer', img: '/img/team-michael.jpg' },
  { name: 'Rafael', role: 'Consultant', img: '/img/team-rafael.jpg' },
  { name: 'Adrian', role: 'Junior Consultant', img: '/img/team-adrian.jpg' },
  { name: 'Arijan', role: 'Werkstudent', initials: 'AR' },
  { name: 'Lisa', role: 'Kommunikation', initials: 'LI' },
  { name: 'Lara', role: 'Recruiting & HR', initials: 'LA' },
];

const certs = [
  'Content Marketing', 'E-Mail Marketing', 'Growth-Driven Design Agency', 'HubSpot Marketing Hub Software',
  'HubSpot Sales Hub Software', 'HubSpot Service-Software', 'Inbound Sales', 'Inbound-Marketing',
  'Inbound-Methodik', 'Reibungsloser Vertrieb', 'Sales-Software', 'Solutions Partner',
];

const criteria = [
  'Sie sind überwiegend ein B2B-Unternehmen mit 40 bis 1.000 Mitarbeitenden.',
  'Sie nutzen HubSpot bereits oder planen die Einführung mit langfristiger Perspektive.',
  'Sie wollen Marketing, Sales und ggf. Service in einem System abbilden.',
  'HubSpot soll keine Insellösung sein, sondern in Ihre IT-Landschaft integriert werden.',
  'Ihre internen Teams sollen selbstständig arbeiten können — nicht dauerhaft extern abhängig sein.',
  'Sie haben bereits ein Datenmodell im Kopf — oder wissen, dass Sie eines brauchen.',
];
---
<Base active="ueber-uns" title="Über CogniCore — HubSpot-Partner mit technischer Tiefe | Köln" description="CogniCore IT Solutions: HubSpot Solutions Partner aus dem Mediapark Köln. Techniker und Berater in einem — mit Tiefgang in Datenmodell, Prozess- und API-Integration. Team, Mission und Zertifizierungen.">
  <!-- HERO -->
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"><img src="/brand/cognicore-icon-white.png" alt="" /></div>
    <div class="cc-hero__inner" style="grid-template-columns:1fr; padding-bottom:64px">
      <div class="cc-hero__copy" style="max-width:820px">
        <div class="cc-eyebrow">// Über uns</div>
        <h1 class="cc-hero__title" style="font-size:56px">Kein klassisches Marketing.<br/><em>Tiefgang</em> in Datenmodell &amp; Integration.</h1>
        <p class="cc-hero__lede">Wir sind keine klassische Marketing-Agentur, sondern HubSpot-Partner mit Tiefgang in Datenmodell und Solution Design — Techniker und Berater in einem, mit Hauptsitz im Mediapark Köln.</p>
      </div>
    </div>
  </section>

  <!-- TEAM (mit Rollen) -->
  <section class="cc-section">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">// Team</div>
      <h2>Beratung kauft man über Köpfe.</h2>
      <p class="cc-section__sub">Ein interdisziplinäres Team aus Strateg:innen, Solution Architects und HubSpot-Spezialist:innen — mit festen Ansprechpartnern, die Ihr Setup wirklich kennen.</p>
    </div>
    <div class="cc-grid cc-grid--4 cc-reveal">
      {team.map((m) => (
        <figure class="cc-card" style="align-items:center; text-align:center; gap:14px">
          {m.img
            ? <img src={m.img} alt={m.name} width="120" height="120" loading="lazy" style="width:104px; height:104px; border-radius:999px; object-fit:cover" />
            : <div class="cc-quote__avatar" style="width:104px; height:104px; font-size:30px">{m.initials}</div>}
          <figcaption><b style="display:block; color:var(--cc-blue); font-weight:700">{m.name}</b><span style="color:var(--cc-orange-ink); font-size:13px; font-weight:600">{m.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- MISSION / WARUM -->
  <section class="cc-section cc-section--beige">
    <div class="cc-split cc-reveal">
      <div>
        <div class="cc-eyebrow">// Unsere Mission</div>
        <h2 style="font-size:30px; margin-top:8px">Wachstum planbar machen.</h2>
        <p>Wir befähigen B2B-Unternehmen, mit HubSpot ihr Wachstum planbar zu steigern und ihren Teams Freiraum für Kunden und Innovation zu schaffen. Dazu kombinieren wir Strategie, Technologie und Kreativität — und führen Sie Schritt für Schritt durch ein skalierbares Drei-Stufen-Modell.</p>
      </div>
      <div>
        <div class="cc-eyebrow">// Warum wir tun, was wir tun</div>
        <h2 style="font-size:30px; margin-top:8px">Systeme, die Prozesse abbilden.</h2>
        <p>Weil moderne B2B-Unternehmen mehr brauchen als Tools und Templates: Systeme, die ihre Prozesse abbilden — nicht einschränken. Wir kommen selbst aus dem Unternehmertum und bauen keine isolierten Lösungen, sondern Plattformen, die Geschäftsmodelle tragen und Teams handlungsfähig machen. HubSpot ist für uns kein Selbstzweck, sondern Mittel zum Ziel: Effizienz, Klarheit, skalierbarer Erfolg.</p>
      </div>
    </div>
  </section>

  <!-- ZERTIFIZIERUNGEN -->
  <section class="cc-section cc-section--surface">
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">// Belegt</div>
      <h2>Offizieller HubSpot Solutions Partner.</h2>
      <p class="cc-section__sub">Zertifizierte Tiefe über Marketing, Sales, Service und Inbound — 13 aktuelle HubSpot-Zertifizierungen als nachprüfbares Kompetenzsignal.</p>
    </div>
    <div class="cc-grid cc-grid--3 cc-reveal">
      {certs.map((c) => (
        <div class="cc-card" style="flex-direction:row; align-items:center; gap:12px; padding:16px 20px">
          <span class="cc-card__ic" style="width:36px; height:36px; flex:none" set:html={check} />
          <span style="font-weight:600; font-size:15px; color:var(--cc-blue)">{c}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- PASST ZU IHNEN -->
  <section class="cc-section">
    <div class="cc-section__head center cc-reveal">
      <div class="cc-eyebrow">// Fit-Check</div>
      <h2>Passt CogniCore zu Ihnen?</h2>
      <p class="cc-section__sub">Wir arbeiten am besten mit Häusern, auf die das Meiste hiervon zutrifft.</p>
    </div>
    <ul class="cc-checks cc-reveal" style="max-width:820px; margin:0 auto; gap:16px">
      {criteria.map((c) => <li set:html={check + ' ' + c} style="font-size:17px" />)}
    </ul>
  </section>

  <!-- KARRIERE -->
  <section class="cc-section cc-section--beige" id="karriere">
    <div class="cc-split cc-reveal">
      <div>
        <div class="cc-eyebrow">// Karriere</div>
        <h2 style="font-size:32px; margin-top:8px">Köpfe mit Tiefgang gesucht.</h2>
        <p>Wir wachsen — und suchen Menschen, die HubSpot, Datenmodelle und Integration nicht nur bedienen, sondern verstehen wollen. Flexibel, remote-freundlich, mit echtem Lernumfeld und anspruchsvollen Projekten.</p>
        <p>Keine passende Stelle ausgeschrieben? Initiativbewerbungen sind ausdrücklich willkommen.</p>
        <a class="cc-btn cc-btn--primary" href="mailto:info@cognicore.de?subject=Initiativbewerbung" style="margin-top:16px">Initiativ bewerben</a>
      </div>
      <div>
        <ul class="cc-checks">
          <li set:html={check + ' Anspruchsvolle HubSpot- & Integrationsprojekte'} />
          <li set:html={check + ' Remote-freundlich, Hauptsitz Mediapark Köln'} />
          <li set:html={check + ' Lern- & Weiterbildungsumfeld, Zertifizierungen'} />
          <li set:html={check + ' Kurze Wege, direkter Draht zu den Gründern'} />
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cc-section cc-section--surface" style="text-align:center">
    <div class="cc-reveal">
      <h2 style="font-size:clamp(28px,3.4vw,40px)">Lernen wir uns kennen.</h2>
      <p class="cc-section__sub" style="margin:12px auto 24px; max-width:520px">Ein Erstgespräch, 30 Minuten, kein Pitch.</p>
      <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
    </div>
  </section>
</Base>
