---
import Base from '../layouts/Base.astro';

const certs = [
  { label: 'Content Marketing', img: 'Zertifizierungsbadge_Content_Marketing.png' },
  { label: 'E-Mail Marketing', img: 'Zertifizierungsbadge_E-Mail-Marketing.png' },
  { label: 'Growth-Driven Design Agency', img: 'Zertifizierungsbadge_Growth-Driven_Design_Agency.png' },
  { label: 'HubSpot Marketing Hub Software', img: 'Zertifizierungsbadge_HubSpot_Marketing_Hub_Software_Certification.png' },
  { label: 'HubSpot Marketing-Software', img: 'Zertifizierungsbadge_HubSpot_Marketing_Hub_Software_Certification.png' },
  { label: 'HubSpot Sales Hub Software', img: 'Zertifizierungsbadge_HubSpot_Sales_Hub_Software_Certification.png' },
  { label: 'HubSpot Service-Software', img: 'Zertifizierungsbadge_HubSpot_Service-Software.png' },
  { label: 'Inbound Sales', img: 'Zertifizierungsbadge_Inbound_Sales-Zertifizierung.png' },
  { label: 'Inbound-Marketing', img: 'Zertifizierungsbadge_Inbound-Marketing.png' },
  { label: 'Inbound-Methodik', img: 'Zertifizierungsbadge_Inbound-Methodik.png' },
  { label: 'Reibungsloser Vertrieb', img: 'Zertifizierungsbadge_Reibungsloser_Vertrieb.png' },
  { label: 'Sales-Software', img: 'Zertifizierungsbadge_Sales-Software-Zertifizierung.png' },
  { label: 'Solutions Partner', img: 'Zertifizierungsbadge_Solutions_Partner_Zertifizierung.png' },
];

const criteria = [
  'Ihr seid überwiegend ein B2B-Unternehmen mit 40 bis 1.000 Mitarbeitenden.',
  'Ihr nutzt HubSpot bereits oder plant eine Einführung mit langfristiger Perspektive.',
  'Ihr wollt Marketing, Sales und ggf. Service in einem System abbilden.',
  'HubSpot soll keine Insellösung sein, sondern in eure bestehende IT-Landschaft integriert werden.',
  'Eure internen Teams sollen mit dem System selbstständig arbeiten können – nicht dauerhaft extern abhängig sein.',
  'Ihr habt bereits ein Datenmodell im Kopf – oder wisst, dass ihr eines braucht.',
];

const gallery = ['gallery/1.jpg', 'gallery/2.jpg', 'gallery/3.jpg', 'gallery/4.jpg', 'gallery/5.png', 'gallery/6.jpg', 'gallery/7.jpg', 'gallery/8.jpg', 'gallery/9.jpg'];
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
---
<Base active="ueber-uns" title="CogniCore: Dein HubSpot-Partner für CRM, Automatisierung & Prozesse" description="CogniCore IT Solutions – offizieller HubSpot Solutions Partner aus dem Mediapark Köln. Zertifizierte Tiefe in CRM, Automatisierung und Prozessintegration für B2B-Unternehmen.">
  <!-- HERO -->
  <section class="page-hero" style="background-image:url('/img/ueber-hero.jpg')">
    <div class="wrap">
      <h1>Über uns</h1>
      <p class="lede">Wir machen HubSpot zum Herzstück eurer Skalierung – klar, messbar, zukunftssicher.</p>
    </div>
  </section>

  <!-- SOLUTIONS PARTNER + ZERTIFIZIERUNGEN -->
  <section class="section">
    <div class="wrap">
      <div class="center-head reveal">
        <h2>Offizieller HubSpot Solutions Partner mit zertifizierter Tiefe</h2>
        <p class="lead">Unsere Expertise basiert auf mehr als zehn Jahren Projekterfahrung in der HubSpot-Welt – strategisch, technisch und zertifiziert.</p>
      </div>
      <div class="cert-split reveal">
        <div>
          <p>Durch unsere enge Partnerschaft mit HubSpot bieten wir <strong>maßgeschneiderte Lösungen für Marketing, Sales, Service und Operations</strong>, die nahtlos in eure bestehende Unternehmensstruktur integriert werden können.</p>
          <p>Fragst du dich, was man über uns sagt? Schau mal in die Bewertungen im offiziellen <a href="https://ecosystem.hubspot.com/marketplace/solutions/cognicore" target="_blank" rel="noopener">Anbieterverzeichnis</a> von HubSpot.</p>
          <p>Du willst wissen, wie wir HubSpot-Projekte konkret umsetzen? Dann wirf einen Blick auf unsere <a href="/leistungen">Leistungen</a>.</p>
          <p>Oder <a href="/kontakt">kontaktiere uns direkt</a> für ein erstes Gespräch.</p>
        </div>
        <div class="cert-list">
          <h3>Unsere Zertifizierungen</h3>
          <ul>
            {certs.map((c) => (
              <li><img src={`/img/badges/${c.img}`} alt={`HubSpot Zertifizierung ${c.label}`} width="34" height="34" loading="lazy" />{c.label}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION / WARUM -->
  <section class="section" style="background:var(--grey)">
    <div class="wrap">
      <div class="mission-block reveal">
        <span class="eyebrow">Unsere Mission</span>
        <p>Wir befähigen B2B-Unternehmen, mit HubSpot ihr Wachstum planbar zu steigern und ihren Teams Freiraum für Kunden und Innovation zu schaffen. Dazu kombinieren wir Strategie, Technologie und Kreativität – und führen unsere Kunden Schritt für Schritt durch ein skalierbares Drei-Stufen-Modell (Essential | Advanced | Excellence), das vom schnellen Einstieg bis zur individuellen Integrationsarchitektur reicht.</p>
      </div>
      <div class="mission-block reveal">
        <span class="eyebrow">Warum wir tun, was wir tun</span>
        <p>Weil wir glauben, dass moderne B2B-Unternehmen mehr brauchen als Tools und Templates. Sie brauchen Systeme, die ihre Prozesse abbilden – nicht einschränken. Wir kommen selbst aus dem Unternehmertum, kennen die Herausforderungen von Wachstum und Komplexität. Deshalb bauen wir keine isolierten Lösungen, sondern Plattformen, die Geschäftsmodelle tragen, Daten sinnvoll verknüpfen und Teams selbstständig handlungsfähig machen. Für uns ist HubSpot kein Selbstzweck, sondern Mittel zum Ziel: Effizienz, Klarheit und skalierbarer Erfolg.</p>
      </div>
    </div>
  </section>

  <!-- PASST COGNICORE ZU EUCH -->
  <section class="section">
    <div class="wrap">
      <div class="center-head reveal">
        <h2>Passt CogniCore zu euch?</h2>
        <p class="lead">Wir sind keine klassische Marketing-Agentur, sondern HubSpot-Partner mit Tiefgang in Datenmodell und Solution Design.</p>
      </div>
      <ul class="criteria reveal">
        {criteria.map((c) => (<li><span class="ck" set:html={check} />{c}</li>))}
      </ul>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="section">
    <div class="wrap">
      <div class="center-head reveal">
        <h2>Vertrauen entsteht, wenn man weiß, mit wem man es zu tun hat.</h2>
        <p class="lead">Eindrücke aus unserem Alltag in unserem Büro im Mediapark.</p>
      </div>
      <div class="gallery reveal">
        {gallery.map((g) => (<img src={`/img/${g}`} alt="CogniCore – Büro im Mediapark Köln" width="400" height="267" loading="lazy" />))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-cream">
    <div class="wrap">
      <h2>Lasst uns HubSpot für euch aufs nächste Level bringen!</h2>
      <a href="/kontakt" class="btn btn-primary">Erstgespräch vereinbaren</a>
    </div>
  </section>
</Base>
