---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';

const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

const bausteine = [
  { t: 'Der Vertrag als eigenes Objekt', d: 'Laufzeit, Paket, Arbeitsplätze, Kündigungsfrist und Kontingent stehen am Vertrag selbst. Sie sehen jederzeit, welche Verträge laufen und wann sie enden.' },
  { t: 'Kontingentverbrauch je Vertrag', d: 'Der Verbrauch kommt aus Ihrer Zeiterfassung oder dem PSA ins CRM. Liegt ein Kunde über Monate über seinem Kontingent, erfährt der Vertrieb es, bevor die Marge leidet.' },
  { t: 'PSA und RMM am Kunden', d: 'Tickets, Geräte und offene Störungen aus Ihrem PSA- oder RMM-System stehen am Kunden. Wer eine Verlängerung oder ein Upgrade anbietet, weiß, wie es dort gerade läuft.' },
  { t: 'Eingerichtet von einem IT-Dienstleister', d: 'Wir betreiben selbst Serviceverträge mit festen Paketen und Reaktionszeiten. Auf die Fragen, die Ihr Setup beantworten muss, brauchen wir für unsere eigenen Verträge jeden Monat selbst eine Antwort.' },
];

const auchDabei = [
  'Pipelines für Neukunden, Bestandskunden und Verlängerungen',
  'Erinnerung rechtzeitig vor jeder Verlängerung',
  'Dashboard mit wiederkehrendem Umsatz, Verlängerungen und Kontingentverbrauch',
];

const ablauf = [
  { t: 'Bestandsaufnahme', d: 'Vertriebs- und Vertragsprozesse, vorhandene Systeme und Daten.' },
  { t: 'Einrichtung', d: 'Das vorkonfigurierte Setup an Ihre Pakete und Abläufe anpassen.' },
  { t: 'Anbindung', d: 'PSA, RMM und Buchhaltung je nach Bedarf verbinden.' },
  { t: 'Übergabe', d: 'Datenübernahme, Schulung und Go-Live.' },
];
---
<Base active="branchen" title="HubSpot für IT-Dienstleister und MSPs | CogniCore Köln" description="HubSpot vorkonfiguriert für IT-Dienstleister und Managed Service Provider: Serviceverträge, Verlängerungen, PSA- und RMM-Anbindung. Von einem Partner, der selbst IT-Betrieb macht.">
  <!-- HERO -->
  <section class="cc-hero">
    <div class="cc-hero__bg" aria-hidden="true"><img src="/brand/cognicore-icon-white.png" alt="" /></div>
    <div class="cc-hero__inner" style="grid-template-columns:1fr; padding-bottom:72px">
      <div class="cc-hero__copy" style="max-width:820px">
        <div class="cc-eyebrow">Branche · IT-Dienstleister und MSPs</div>
        <h1 class="cc-hero__title" style="font-size:56px">HubSpot für <em>IT-Dienstleister</em>.</h1>
        <p class="cc-hero__lede" style="max-width:700px">Wir betreiben selbst Microsoft 365 für Kunden, mit Serviceverträgen, Paketen und Verlängerungen. Deshalb richten wir HubSpot so ein, dass es Ihre Verträge abbildet: Laufzeit, Kontingent und Verlängerung, angebunden an Ihr PSA- oder RMM-System.</p>
        <div class="cc-hero__actions" style="margin-bottom:0">
          <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
          <a class="cc-btn cc-btn--ghost-light" href="#setup">Das Setup ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SETUP: was über eine Vertriebsvorlage hinausgeht -->
  <section class="cc-section cc-section--surface" id="setup">
    <div>
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">Vorkonfiguriertes Setup</div>
      <h2>Gebaut für Serviceverträge.</h2>
      <p class="cc-section__sub">Pipelines für Neukunden und Bestandskunden sind schnell eingerichtet. Bei IT-Dienstleistern hängt der Umsatz aber an laufenden Verträgen, und die bildet ein reines Vertriebs-Setup kaum ab.</p>
    </div>
    <div class="cc-grid cc-grid--2 cc-reveal">
      {bausteine.map((b, i) => (
        <article class={`cc-card${i === 3 ? ' cc-card--orange' : ''}`}>
          <div class="cc-card__num">{String(i + 1).padStart(2, '0')}</div>
          <h3>{b.t}</h3>
          <p>{b.d}</p>
        </article>
      ))}
    </div>
    <div class="cc-card cc-reveal" style="margin-top:32px">
      <div class="cc-eyebrow">Außerdem im Setup</div>
      <ul class="cc-checks" style="margin-top:6px">{auchDabei.map((x) => <li set:html={check + ' ' + x} />)}</ul>
    </div>
    </div>
  </section>

  <!-- WORUM ES GEHT -->
  <section class="cc-section">
    <div class="cc-split cc-reveal" style="align-items:start">
      <div class="cc-split__body">
        <div class="cc-eyebrow">Worum es geht</div>
        <p style="font-size:19px; color:var(--cc-blue); margin-top:12px">Ein Standard-CRM ist auf den einzelnen Abschluss ausgelegt. Laufzeiten, Kontingente und Verlängerungen kommen darin kaum vor, dabei entscheiden sie bei IT-Dienstleistern über Umsatz und Marge.</p>
        <p style="font-size:16.5px">Wir kennen das aus dem eigenen Betrieb. Für die Verwaltung unserer Serviceverträge haben wir mit MSP OS sogar ein eigenes Werkzeug gebaut.</p>
      </div>
      <div class="cc-card">
        <div class="cc-eyebrow">Für wen</div>
        <ul class="cc-checks" style="margin-top:6px">
          <li set:html={check + ' Managed Service Provider mit Serviceverträgen'} />
          <li set:html={check + ' IT-Systemhäuser mit Projekt- und Vertragsgeschäft'} />
          <li set:html={check + ' IT-Dienstleister, die HubSpot neu einführen oder neu aufsetzen wollen'} />
        </ul>
      </div>
    </div>
  </section>

  <!-- ABLAUF + PREIS -->
  <section class="cc-section">
    <div class="cc-grid cc-grid--2 cc-reveal" style="align-items:start; gap:40px">
      <div>
        <div class="cc-eyebrow">Ablauf</div>
        <h2 style="font-size:34px; color:var(--cc-blue); margin-top:8px">So gehen wir vor.</h2>
        <ol style="list-style:none; padding:0; margin:18px 0 0; display:flex; flex-direction:column; gap:16px">
          {ablauf.map((s, i) => (
            <li style="display:flex; gap:16px; align-items:flex-start">
              <span class="cc-card__num" style="flex:none; width:40px; height:40px; font-size:14px">{String(i + 1).padStart(2, '0')}</span>
              <span><b style="display:block; font-family:var(--cc-font-display); color:var(--cc-blue)">{s.t}</b><span style="color:var(--cc-fg-2); font-size:15px">{s.d}</span></span>
            </li>
          ))}
        </ol>
      </div>
      <div class="cc-price">
        <div class="cc-eyebrow cc-eyebrow--on-dark">Preis</div>
        <p class="cc-price__wert">ab 4.900 €</p>
        <p class="cc-price__einheit">einmalig für die Einführung</p>
        <p class="cc-price__hinweis">Enthalten sind Vertragsobjekt, Kontingentlogik, Pipelines, Berichte und Schulung. Mit Datenübernahme aus einem Altsystem ab 9.500 €. Die Anbindung an PSA oder RMM bekommt einen Festpreis nach der Bestandsaufnahme.</p>
        <p class="cc-price__fuss">Alle Preise netto zzgl. USt. Die HubSpot-Lizenzen zahlen Sie direkt an HubSpot.</p>
        <a class="cc-btn cc-btn--accent" href="/kontakt#termin">Erstgespräch vereinbaren</a>
      </div>
    </div>
  </section>

  <!-- AUCH INTERESSANT -->
  <section class="cc-section cc-section--surface">
    <div>
    <div class="cc-section__head cc-reveal">
      <div class="cc-eyebrow">Passt dazu</div>
      <h2>Was oft zusammen gebraucht wird.</h2>
    </div>
    <div class="cc-grid cc-grid--3 cc-reveal">
      <article class="cc-card"><div class="cc-eyebrow">Lösungen</div><h3>MSP OS</h3><p>Portal für Serviceverträge: Onboarding, Leistungsnachweis und Abrechnung an einer Stelle.</p><a class="cc-card__link" href="/loesungen">Ansehen →</a></article>
      <article class="cc-card"><div class="cc-eyebrow">Daten und Integration</div><h3>Schnittstellen und Betrieb</h3><p>HubSpot mit PSA, RMM und Buchhaltung verbinden und die Schnittstelle betreiben.</p><a class="cc-card__link" href="/leistungen/schnittstellen">Ansehen →</a></article>
      <article class="cc-card"><div class="cc-eyebrow">HubSpot</div><h3>HubSpot Managed Service</h3><p>Feste Betreuung Ihres Portals mit monatlichem Stundenkontingent.</p><a class="cc-card__link" href="/leistungen/hubspot-managed-service">Ansehen →</a></article>
    </div>
    </div>
  </section>

  <CtaBand title="Lassen Sie uns über Ihren" em="Vertrieb" text="Ein Erstgespräch, 30 Minuten, von IT-Dienstleister zu IT-Dienstleister." />
</Base>
