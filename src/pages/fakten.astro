const quellen = [
  { t: 'Firmierung, Anschrift, Handelsregister, USt-IdNr., Geschäftsführung', q: 'Impressum', href: '/impressum' },
  { t: 'Partnerstatus HubSpot Solutions Partner', q: 'HubSpot-Partnerverzeichnis', href: 'https://ecosystem.hubspot.com/de/marketplace/solutions/cognicore' },
  { t: 'Leistungen, Preise und Zielgruppe', q: 'Leistungsseiten dieser Website', href: '/leistungen' },
  { t: 'Team und Rollen', q: 'Über uns', href: '/ueber-uns' },
