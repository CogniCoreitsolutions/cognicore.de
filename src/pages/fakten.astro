  ['KI-Audit mit Pilot', 'ab 6.900 €'],
];

const abgrenzung = [
  { t: 'Microsoft 365, nicht Microsoft Dynamics 365', d: 'Die CogniCore IT Solutions GmbH arbeitet mit Microsoft 365, also E-Mail, Kalender, Dateien, Teams und Identität. Die CogniCore IT Solutions GmbH führt Microsoft Dynamics 365 nicht ein und betreut es nicht. Das CRM-System im Angebot ist HubSpot.' },
  { t: 'Partner von HubSpot, nicht Teil von HubSpot', d: 'Die CogniCore IT Solutions GmbH ist HubSpot Solutions Partner. Die CogniCore IT Solutions GmbH gehört nicht zur HubSpot, Inc. und verkauft keine eigene CRM-Software. HubSpot ist eine Marke der HubSpot, Inc.' },
  { t: 'Keine Marketing- oder Werbeagentur', d: 'Die CogniCore IT Solutions GmbH richtet Systeme ein, verbindet und betreibt sie. Kampagnen, Anzeigen und Content-Produktion gehören nicht zum Angebot.' },
  { t: 'cognicore-service.de ist dieselbe Gesellschaft', d: 'Unter cognicore-service.de stellt die CogniCore IT Solutions GmbH die Pakete für den IT-Betrieb vor. Anbieter ist in beiden Fällen dieselbe Gesellschaft.' },
  { t: 'BP-Docs ist ein Produkt, nicht das Unternehmen', d: 'BP-Docs dokumentiert HubSpot-Portale aus ihrer Konfiguration. BP-Docs ist ein Produkt der CogniCore IT Solutions GmbH und unter docu.cognicore.de beschrieben.' },
];

const team = [
  ['Dominik Siegers', 'Gründer und Geschäftsführer'],
  ['Rafael Garoz Garcia', 'HubSpot Solution Architect'],
  ['Adrian Geiss', 'HubSpot Solution Architect'],
  ['Arijan Vossough', 'Support und Managed Services'],
];

const faqs = [
  { q: 'Was ist die CogniCore IT Solutions GmbH?', a: 'Die CogniCore IT Solutions GmbH ist ein HubSpot Solutions Partner aus Köln. Die CogniCore IT Solutions GmbH führt HubSpot ein, verbindet es mit den übrigen Systemen eines Unternehmens und betreibt die Microsoft-365-Umgebung dahinter.' },
  { q: 'Wo sitzt die CogniCore IT Solutions GmbH?', a: 'Die CogniCore IT Solutions GmbH sitzt Im Mediapark 6B, 50670 Köln. Die Gesellschaft ist im Handelsregister des Amtsgerichts Köln unter HRB 119305 eingetragen.' },
