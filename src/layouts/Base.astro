---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title = 'HubSpot-Partner für B2B in Köln — Onboarding, Integration & RevOps | CogniCore',
  description = 'CogniCore IT Solutions ist offizieller HubSpot Solutions Partner aus Köln: HubSpot sauber implementiert, in Ihre Systeme integriert und laufend betreut — mit Tiefgang in Datenmodell, Prozess- und API-Integration.',
  active,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://new.cognicore.de').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'CogniCore IT Solutions GmbH',
  description: 'HubSpot Solutions Partner & IT-Dienstleister für den B2B-Mittelstand.',
  url: 'https://cognicore.de',
  telephone: '+49 221 6505 3000',
  email: 'info@cognicore.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Im Mediapark 6B',
    postalCode: '50670',
    addressLocality: 'Köln',
    addressCountry: 'DE',
  },
  areaServed: ['DE', 'AT', 'CH'],
  knowsAbout: ['HubSpot', 'CRM', 'RevOps', 'Prozessautomatisierung', 'API-Integration', 'Managed IT'],
  logo: new URL('/brand/cognicore-logo-blue-orange.png', Astro.site ?? 'https://new.cognicore.de').href,
};
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/brand/cognicore-icon-blue-orange.png" />
  <link rel="preload" href="/fonts/Raleway-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:url" content={canonical} />
  <!-- Staging: bis zum Go-live nicht indexieren. Zum Launch entfernen. -->
  <meta name="robots" content="noindex" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a href="#inhalt" class="cc-skip">Zum Inhalt springen</a>
  <Nav active={active} />
  <main id="inhalt">
    <slot />
  </main>
  <Footer />

  <script>
    // Mobile-Navigation
    const header = document.getElementById('site-header');
    const burger = document.getElementById('cc-burger');
    burger?.addEventListener('click', () => {
      const open = header?.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.querySelectorAll('#cc-mobile a').forEach((a) =>
      a.addEventListener('click', () => header?.classList.remove('open')),
    );
    // Reveal (Progressive Enhancement — Inhalt ist ohne JS sichtbar)
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.cc-reveal:not(.in)').forEach((el) => io.observe(el));
  </script>
</body>
</html>
